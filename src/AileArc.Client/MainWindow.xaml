<Window x:Class="AileArc.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AileArc.Client"
  Title="{local:Text ClientTitle}" Width="1320" Height="850" MinWidth="1060" MinHeight="650" WindowStartupLocation="CenterScreen"
  Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WarmGraphite.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="218" MinWidth="180" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailDivider" Width="1" /><ColumnDefinition x:Name="DetailColumn" Width="254" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" Padding="16,20">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Bottom" Text="{local:Text ClientReadOnly}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
          <StackPanel>
            <TextBlock Text="{local:Text ClientArchive}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <Button x:Name="RootButton" Click="Root_Click" HorizontalContentAlignment="Left" Content="{local:Text Welcome}" AutomationProperties.AutomationId="Root" />
            <ItemsControl x:Name="Folders" Margin="4,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
              <Button Content="{Binding Name}" Tag="{Binding Path}" Click="Folder_Click" HorizontalContentAlignment="Left" ToolTip="{Binding Path}" />
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20" />
            <Button x:Name="CreateButton" Content="{local:Text CreateArchive}" Click="Create_Click" Margin="0,0,0,8" />
            <Button x:Name="CopiesButton" Content="{local:Text WorkCopies}" Click="Copies_Click" Margin="0,0,0,16" />
            <Button x:Name="RecoveryButton" Content="{local:Text Recovery}" Click="Recovery_Click" Margin="0,0,0,8" />
            <TextBlock x:Name="CopyNotice" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{local:Text Language}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
            <ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed" AutomationProperties.Name="{local:Text Language}" />
            <Button x:Name="RestartButton" Content="{local:Text RestartNow}" Click="Restart_Click" Visibility="Collapsed" Margin="0,8,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource LineBrush}" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="65" /><RowDefinition Height="52" /><RowDefinition Height="0" /><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
        <DockPanel Margin="18,12">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="BackButton" FontFamily="Segoe Fluent Icons" Content="&#xE72B;" ToolTip="{local:Text Back}" AutomationProperties.Name="{local:Text Back}" Click="Back_Click" Width="32" Padding="0" /><Button x:Name="ForwardButton" FontFamily="Segoe Fluent Icons" Content="&#xE72A;" ToolTip="{local:Text Forward}" AutomationProperties.Name="{local:Text Forward}" Click="Forward_Click" Width="32" Padding="0" /><Button x:Name="UpButton" FontFamily="Segoe Fluent Icons" Content="&#xE74A;" ToolTip="{local:Text Up}" AutomationProperties.Name="{local:Text Up}" Click="Up_Click" Width="32" Padding="0" /></StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="ExtractButton" Content="{local:Text ClientExtractAll}" Click="Extract_Click" Style="{StaticResource Primary}" Margin="8,0,0,0" />
            <Button x:Name="ExtractMore" Content="▾" ToolTip="{local:Text ClientExtractMode}" AutomationProperties.Name="{local:Text ClientExtractMode}" Click="ExtractMore_Click">
              <Button.ContextMenu><ContextMenu Style="{StaticResource ExtractMenu}" ItemContainerStyle="{StaticResource ExtractMenuItem}" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}">
                <MenuItem Header="{local:Text ClientExtractAll}" Click="AllExtract_Click"/>
                <MenuItem Header="{local:Text SmartExtract}" Click="SmartExtract_Click"/>
                <MenuItem Header="{local:Text ClientExtractHere}" Click="HereExtract_Click"/>
              </ContextMenu></Button.ContextMenu>
            </Button>
            <Button x:Name="ShowDetails" Content="{local:Text ClientShowDetails}" Visibility="Collapsed" Click="ToggleDetails_Click" Margin="6,0,0,0"/>
          </StackPanel>
          <Grid Margin="6,0" Background="{StaticResource SurfaceBrush}"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Crumbs" Orientation="Horizontal" MouseLeftButtonDown="Address_MouseDown" Background="Transparent" /></ScrollViewer><TextBox x:Name="AddressInput" Visibility="Collapsed" KeyDown="Address_KeyDown" LostKeyboardFocus="Address_Blur" AutomationProperties.Name="{local:Text Path}" /></Grid>
        </DockPanel>
        <Grid Grid.Row="1" Margin="18,0,18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="SearchBox" MaxLength="512" KeyDown="Search_KeyDown" TextChanged="Search_TextChanged" AutomationProperties.Name="{local:Text Search}" AutomationProperties.AutomationId="ArchiveSearch" />
            <TextBlock x:Name="SearchHint" Text="{local:Text Search}" Style="{StaticResource Muted}" Margin="13,0" IsHitTestVisible="False" />
          </Grid>
          <CheckBox Grid.Column="1" x:Name="LocalSearchBox" Content="{local:Text CurrentDirectory}" Click="Scope_Click" Margin="10,0,0,0" />
          <Button x:Name="SearchSubmit" Grid.Column="2" Content="{local:Text ClientSearchButton}" Click="Search_Click" Margin="8,0,0,0" Style="{StaticResource Primary}" AutomationProperties.AutomationId="SearchSubmit" />
        </Grid>

        <DataGrid x:Name="EntryGrid" Grid.Row="3" Background="{StaticResource CanvasBrush}" BorderThickness="0" AutoGenerateColumns="False" IsReadOnly="True"
          SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" Sorting="Grid_Sorting" CanUserReorderColumns="False"
          HeadersVisibility="Column" RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2E2B28"
          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick" PreviewKeyDown="Grid_KeyDown"
          AutomationProperties.Name="{local:Text ClientEntryList}" AutomationProperties.AutomationId="ArchiveEntries">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="46" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllBox" IsThreeState="True" Click="All_Click" AutomationProperties.Name="{local:Text ClientSelectAll}" /></DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" PreviewMouseLeftButtonDown="RowCheck_MouseDown" AutomationProperties.Name="{Binding Name}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="NameColumn" SortMemberPath="Name" Header="{local:Text Name}" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" /><TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Path}" /></Grid>
            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn x:Name="PathColumn" SortMemberPath="Path" Header="{local:Text Path}" Binding="{Binding Path}" Width="*" MinWidth="100" Visibility="Collapsed" />
            <DataGridTextColumn x:Name="TypeColumn" SortMemberPath="Type" Header="{local:Text ClientType}" Binding="{Binding TypeLabel}" Width="110" />
            <DataGridTextColumn x:Name="SizeColumn" SortMemberPath="Size" Header="{local:Text ClientSize}" Binding="{Binding SizeLabel}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="3" Text="{local:Text NoResults}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
        <DockPanel Grid.Row="4" Margin="18,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="EncodingBox" Width="180" SelectionChanged="Encoding_Changed" AutomationProperties.Name="{local:Text FilenameEncoding}" /><Button x:Name="PreviousButton" Content="{local:Text ClientPrevious}" Click="Previous_Click" IsEnabled="False" /><Button x:Name="NextButton" Content="{local:Text ClientNext}" Click="Next_Click" IsEnabled="False" /></StackPanel>
          <TextBlock x:Name="SelectionText" Text="{local:Text ClientEmptySelection}" Style="{StaticResource Muted}" />
        </DockPanel>
      </Grid>
      <Border Grid.Column="3" Background="{StaticResource LineBrush}" />
      <Border x:Name="DetailPane" Grid.Column="4" Background="{StaticResource SurfaceBrush}" Padding="18">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button x:Name="HideDetails" DockPanel.Dock="Right" Content="×" Width="32" Padding="0" Click="ToggleDetails_Click" ToolTip="{local:Text ClientHideDetails}" AutomationProperties.Name="{local:Text ClientHideDetails}" />
            <TextBlock Text="{local:Text ClientDetails}" Style="{StaticResource Muted}" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="DetailName" Text="{local:Text ClientSelectHint}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel x:Name="DetailProperties" Margin="0,10">
              <TextBlock x:Name="DetailType" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
              <TextBlock Text="{local:Text Size}" Style="{StaticResource Muted}" />
              <TextBlock x:Name="DetailSize" Margin="0,2,0,12"/>
              <TextBlock Text="{local:Text Path}" Style="{StaticResource Muted}" />
              <TextBlock x:Name="DetailPath" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,12"/>
              <Button x:Name="OpenFileButton" Content="{local:Text ClientDefaultOpen}" Click="OpenFile_Click" Style="{StaticResource Primary}" />
              <Button x:Name="CopyPathButton" Content="{local:Text ClientCopyPath}" Click="CopyPath_Click" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,20" />
            <Button x:Name="DetailClear" Content="{local:Text ClientClearSelection}" Click="Clear_Click" />
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SurfaceBrush}"><DockPanel Margin="16,0">
      <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{local:Text Cancel}" Click="Cancel_Click" Visibility="Collapsed" Padding="8,0" MinHeight="24" />
      <TextBlock x:Name="StatusText" Text="{local:Text ClientIdle}" Style="{StaticResource Muted}" />
    </DockPanel></Border>
  </Grid>
</Window>
